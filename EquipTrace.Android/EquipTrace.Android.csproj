<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.equiptrace.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- CRITICAL: Make the APK 100% self-contained so it runs standalone on any phone without crashing -->
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <TrimMode>none</TrimMode>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>

    <!-- Prevent AAPT from compressing assets so large JS bundles and images can be read without size limits -->
    <AndroidAapt2NoCompress>js;css;png;svg;html;json;woff;woff2;ttf;ico</AndroidAapt2NoCompress>

    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;CA1422;NETSDK1202</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Directly include all built web assets from dist as AndroidAssets under www/ -->
    <AndroidAsset Include="..\dist\**\*" Link="www\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>